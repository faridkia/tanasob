DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MOCK_PAYMENT_FAILURE_RATE=0.0

# assistant app — AI chat. Any OpenAI-chat-completions-shaped gateway works
# (OpenAI, DeepSeek, ArvanCloud AI Gateway, ...); point AI_LLM_API_BASE at it.
AI_LLM_API_BASE=
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_LLM_AUTH_SCHEME=Bearer
# Optional: a separate vision-capable model for the exercise-form photo
# check, if AI_LLM_MODEL above isn't multimodal. Falls back to it if unset.
AI_VISION_MODEL=

# SMS (sms.ir) — session reminders + admin broadcast. Leave blank to
# disable real SMS sending (every send becomes a logged no-op).
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=
